FLASK_ENV=development
SECRET_KEY=
JWT_SECRET_KEY=
DATABASE_URL=sqlite:///highlight_studio.db
ALLOWED_ORIGINS=http://localhost:5500

# 決済(Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STANDARD=
STRIPE_PRICE_ID_PRO=

# メール送信
SENDGRID_API_KEY=
MAIL_FROM_ADDRESS=support@example.com

# 特定商取引法に基づく表記(09-tokushoho.htmlと同じ値を設定すること)
BUSINESS_NAME=
BUSINESS_REP_NAME=
BUSINESS_CONTACT_EMAIL=
SITE_DOMAIN=

# デバッグ用管理者アカウント(無制限・無料でアプリを使えるアカウントを自動作成する)
# 両方設定した状態で起動すると、このメールアドレスのユーザーを is_admin=True で
# 自動作成/更新する。デバッグが終わったら空にするか、アカウント自体を削除すること。
ADMIN_EMAIL=
ADMIN_PASSWORD=
